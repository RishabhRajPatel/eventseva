# Copy to .env (Expo reads EXPO_PUBLIC_* at build time). Only public values belong here:
# never put an API key or secret in the app.

# EventSeva API. Defaults: http://10.0.2.2:3000 on the Android emulator, http://localhost:3000 elsewhere.
EXPO_PUBLIC_API_URL=https://api.eventseva.in

# Cloudinary cloud name (public) for building photo URLs.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=keidpig5
