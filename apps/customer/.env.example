# Copy to .env.local and adjust. Variables starting with EXPO_PUBLIC_ are built into the app.

# Backend base URL. Defaults: http://10.0.2.2:3000 on the Android emulator, http://localhost:3000 elsewhere.
# On a real phone use your computer's LAN address, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=

# Cloudinary cloud name for vendor photos (public; never put an API key or secret in the app).
# Leave empty to show category placeholders.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=keidpig5

# "dev" shows a "Test payment (development)" button (POST /v1/bookings/:id/pay/dev) instead of
# the Razorpay checkout. The backend must run with PAYMENT_PROVIDER=fake. Leave empty for real payments.
EXPO_PUBLIC_PAYMENTS=
