# Copy to .env and fill in. Never commit the real .env.
PORT=3000
DATABASE_URL=postgres://eventseva:eventseva@localhost:5432/eventseva

# Long random strings (e.g. `openssl rand -base64 48`). Required in production.
JWT_SECRET=change-me
OTP_PEPPER=change-me

# OTP provider is not decided yet; "console" prints codes to the server log (development only).
OTP_PROVIDER=console

# Fixed number + OTP for the Google Play reviewer's demo account (leave empty to disable).
REVIEW_PHONE=
REVIEW_OTP=

# Requests per minute per IP (general API / OTP + login routes).
RATE_LIMIT_PER_MIN=100
AUTH_RATE_LIMIT_PER_MIN=10

# Booking money rules (percent of the booking price). Commission comes out of the advance.
ADVANCE_PERCENT=25
COMMISSION_PERCENT=10

# "fake" accepts test payments without Razorpay (development only). Use "razorpay" with real keys.
PAYMENT_PROVIDER=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Seconds between runs of the job that expires old requests and completes past events (0 = off).
BOOKING_SWEEP_SEC=60

# Photos, videos and vendor documents. Copy from Cloudinary → Settings → API Keys.
# The secret stays on the server only; the apps get a short-lived signature per upload.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Encrypts vendor bank account numbers. 32 random bytes: `openssl rand -base64 32`.
# Required in production; never change it once set (old rows could not be read).
BANK_DETAILS_KEY=

# Push notifications (Firebase Cloud Messaging). Firebase console → Project settings → Service accounts →
# Generate new private key, then: base64 -w0 that-file.json. Unset = pushes are only printed in the log.
FIREBASE_SERVICE_ACCOUNT=

# OTP limits per rolling window (not calendar days, so midnight resets nothing). The phone limits are the
# real protection. Many Indian users share one IP (Jio/Airtel CGNAT, venue WiFi): if real users get blocked,
# raise the IP limits (common choice: 30 per hour, 100 per day).
OTP_MAX_PER_PHONE_PER_HOUR=5
OTP_MAX_PER_PHONE_PER_DAY=5
OTP_MAX_PER_IP_PER_HOUR=5
OTP_MAX_PER_IP_PER_DAY=5

# Number of proxies in front of the API (1 on Railway/Render/Nginx). Needed so IP limits see each user's
# real IP instead of the proxy's.
TRUST_PROXY=0

# Daily SMS budget for OTPs (any 24 hours, whole app). At OTP_BUDGET_ALERT_PERCENT the admin dashboard
# warns; at 100% only existing users still get codes (new sign-ups wait); at 150% all codes stop.
# Set it to roughly 3× your normal daily logins.
OTP_DAILY_SMS_BUDGET=2000
OTP_BUDGET_ALERT_PERCENT=80
