# Where the EventSeva API runs. The admin panel proxies /api/* to it (next.config.ts rewrites),
# so the browser never calls the API cross-origin. Read at build time and by `next dev`.
API_URL=http://localhost:3000

# Cloudinary cloud name for photo previews (public, inlined at build time). Without it, moderation
# shows the publicId. Never put a Cloudinary API key or secret in the admin app.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=keidpig5
NEXT_PUBLIC_SUPPORT_EMAIL=support@eventseva.in
